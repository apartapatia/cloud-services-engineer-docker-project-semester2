# =========================================
# Stage 1: Build the Vue.js Application
# =========================================
FROM dhi.io/node:20-alpine3.22-dev AS builder

WORKDIR /app

COPY package.json package-lock.json* ./

RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .

ARG VUE_APP_API_URL
ENV VUE_APP_API_URL=${VUE_APP_API_URL}

# Need because node js have version > 17
ENV NODE_OPTIONS=--openssl-legacy-provider
RUN VUE_APP_API_URL=/api npm run build

# =========================================
# Stage 2: Prepare Nginx (DHI)
# =========================================
FROM dhi.io/nginx:1-alpine3.22 AS runner

COPY nginx.conf /etc/nginx/nginx.conf

COPY --chown=nginx:nginx --from=builder /app/dist /usr/share/nginx/html

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --spider http://127.0.0.1:8080/ || exit 1

ENTRYPOINT ["nginx", "-c", "/etc/nginx/nginx.conf"]
CMD ["-g", "daemon off;"]
